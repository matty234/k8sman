            "timer",
            "tune",
            "upload",
            "verified",
            "vpn_key",
            "warning"
          ],
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        "inputs": {
          "description": "Form fields of a patch action, read as input.\u003cname\u003e.",
          "items": {
            "$ref": "#/$defs/Input"
          },
          "type": "array"
        },
        "label": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/Patch"
        },
        "shell": {
          "$ref": "#/$defs/Shell"
        },
        "shortcut": {
          "type": "string"
        },
        "when": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "Alert": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "message": {
          "description": "CEL expression.",
          "type": "string"
        },
        "section": {
          "enum": [
            "pods",
            "workloads",
            "jobs",
            "nodes",
            "storage",
            "network",
            "custom"
          ],
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "warning",
            "info"
          ],
          "type": "string"
        },
        "since": {
          "description": "CEL expression.",
          "type": "string"
        },
        "when": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "when"
      ],
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "badges"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "items"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bar"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "label",
                "value",
                "max",
                "format"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "chips"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "items",
                "empty"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "code"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "value",
                "language"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "conditions"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "from"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fields"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "items"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "json"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "links"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "items",
                "empty"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "message"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "text",
                "severity"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "rows",
                "columns",
                "sortBy",
                "descending",
                "limit",
                "empty"
              ]
            }
          }
        }
      ],
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/TableColumn"
          },
          "type": "array"
        },
        "descending": {
          "type": "boolean"
        },
        "empty": {
          "type": "string"
        },
        "format": {
          "enum": [
            "number",
            "quantity",
            "percent"
          ],
          "type": "string"
        },
        "from": {
          "description": "CEL expression.",
          "type": "string"
        },
        "items": {
          "description": "fields and badges: a list of items; chips and links: a CEL expression.",
          "oneOf": [
            {
              "items": {
                "type": "object"
              },
              "type": "array"
            },
            {
              "description": "CEL expression.",
              "type": "string"
            }
          ]
        },
        "label": {
          "type": "string"
        },
        "language": {
          "enum": [
            "text",
            "yaml",
            "json",
            "shell"
          ],
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "max": {
          "description": "CEL expression.",
          "type": "string"
        },
        "rows": {
          "description": "CEL expression.",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "type": "string"
        },
        "sortBy": {
          "type": "string"
        },
        "text": {
          "description": "CEL expression.",
          "type": "string"
        },
        "type": {
          "enum": [
            "badges",
            "bar",
            "chips",
            "code",
            "conditions",
            "fields",
            "json",
            "links",
            "message",
            "table"
          ],
          "type": "string"
        },
        "value": {
          "description": "CEL expression.",
          "type": "string"
        },
        "when": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "type"
