          "type": "string"
        },
        "yaml": {
          "description": "One or more YAML documents; the first creates this kind, the others may be any kind. ${namespace} is the editor's namespace; ${name} and ${name:default} are placeholders the user fills.",
          "maxLength": 16384,
          "type": "string"
        }
      },
      "required": [
        "name",
        "yaml"
      ],
      "type": "object"
    }
