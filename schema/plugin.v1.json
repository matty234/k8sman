            "developer_board",
            "dns",
            "edit",
            "edit_note",
            "error",
            "event",
            "extension",
            "fact_check",
            "filter_alt",
            "folder",
            "gpp_maybe",
            "group",
            "history",
            "hub",
            "info",
            "insights",
            "inventory",
            "key",
            "label",
            "lan",
            "language",
            "layers",
            "link",
            "list_alt",
            "lock",
            "memory",
            "monitor_heart",
            "notifications",
            "numbers",
            "open_in_new",
            "person",
            "play_arrow",
            "policy",
            "public",
            "receipt",
            "refresh",
            "restart_alt",
            "rocket_launch",
            "router",
            "rule",
            "schedule",
            "security",
            "settings",
            "shield",
            "speed",
            "stop",
            "storage",
            "sync",
            "sync_alt",
            "task_alt",
            "terminal",
            "timer",
            "tune",
            "upload",
            "verified",
            "vpn_key",
            "warning",
            "icon.png"
          ],
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/Metric"
          },
          "description": "Instant PromQL queries for panels, read as metrics.\u003cname\u003e.",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": "object"
        },
        "panel": {
          "$ref": "#/$defs/Panel"
        },
        "related": {
          "additionalProperties": {
            "$ref": "#/$defs/Related"
          },
          "description": "Related objects for panels and actions, read as related.\u003cname\u003e.",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": "object"
        },
        "scope": {
          "description": "Only for \"*\": namespaced or cluster limits the entry to namespaced or cluster-scoped kinds (default any).",
          "enum": [
            "any",
            "namespaced",
            "cluster"
          ],
          "type": "string"
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/$defs/Status"
            }
          ],
          "description": "The kind's part of the plugin's status line in Settings ▸ Integrations: its object count and counts of objects matching CEL predicates."
        },
        "templates": {
          "description": "Starting points for the resource editor's create mode (not for \"*\"). Need no permissions.",
          "items": {
            "$ref": "#/$defs/Template"
          },
          "maxItems": 20,
          "type": "array"
        },
        "variables": {
          "additionalProperties": {
            "description": "CEL expression.",
            "type": "string"
          },
          "description": "Named CEL values, read as variables.\u003cname\u003e.",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": "object"
        },
        "version": {
          "description": "Pin the API version the entry applies to (default: any).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "instance": {
          "type": "string"
        },
        "query": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "Nav": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "deprecated": true,
          "description": "Deprecated and ignored: plugin sections follow the core ones, and users reorder them in Settings.",
          "type": "string"
        },
        "kinds": {
          "items": {
            "pattern": "^[a-z0-9.-]*/[A-Z][A-Za-z0-9]*$",
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "Panel": {
      "additionalProperties": false,
      "properties": {
        "generic": {
          "description": "For a kind without a compiled-in panel: keep the generic panel's sections after the plugin's (default), collapse them, or replace them with the plugin's.",
          "enum": [
            "keep",
            "collapse",
            "replace"
          ],
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "type": "array"
        },
        "tabs": {
          "description": "Inspector tabs of the plugin's own, after the kind's tabs.",
          "items": {
            "$ref": "#/$defs/Tab"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Patch": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "CEL expression.",
          "type": "string"
        },
        "type": {
          "enum": [
            "merge",
            "json"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "body"
      ],
      "type": "object"
    },
    "Permissions": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "description": "Executables shell actions may run on this computer.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "create": {
          "description": "Kinds create actions may create (never Secrets, ServiceAccounts, RBAC or admission kinds). Since 0.2.20 (set minAppVersion).",
          "items": {
            "pattern": "^[a-z0-9.-]*/[A-Z][A-Za-z0-9]*$",
            "type": "string"
          },
          "type": "array"
        },
        "patch": {
          "description": "Kinds patch actions may change (never Secrets).",
          "items": {
            "not": {
              "const": "/Secret"
            },
            "pattern": "^[a-z0-9.-]*/[A-Z][A-Za-z0-9]*$",
            "type": "string"
          },
          "type": "array"
        },
        "prometheus": {
          "description": "PromQL queries through the Prometheus integration (metrics).",
          "type": "boolean"
        },
        "read": {
          "description": "Kinds the plugin reads: its own and related ones. Secrets: names and keys only.",
          "items": {
            "pattern": "^(\\*|[a-z0-9.-]*/[A-Z][A-Za-z0-9]*)$",
            "type": "string"
          },
          "type": "array"
        },
        "subresources": {
          "description": "Subresources subresource actions may call: kind key + \"/\" + subresource, e.g. kubevirt.io/VirtualMachine/restart. Since 0.2.20 (set minAppVersion).",
          "items": {
            "pattern": "^[a-z0-9.-]*/[A-Z][A-Za-z0-9]*/[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Related": {
      "additionalProperties": false,
      "properties": {
        "filter": {
          "description": "CEL expression. bool, sees each candidate as item: keep those for which it is true, before the list is capped at 200. Alone, the candidates are every object of the kind in the namespace.",
          "type": "string"
        },
        "kind": {
          "description": "Kind key; must be in permissions.read.",
          "pattern": "^[a-z0-9.-]*/[A-Z][A-Za-z0-9]*$",
          "type": "string"
        },
        "limit": {
          "description": "How many objects a list relation keeps (default 200, at most 2000); the panel notes what it left out.",
          "maximum": 2000,
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "CEL expression.",
          "type": "string"
        },
        "namespace": {
          "description": "CEL expression. string: where to look (default: the object's namespace; \"\" = every namespace).",
          "type": "string"
        },
        "owner": {
          "description": "Objects whose ownerReferences include this object (at most 200).",
          "type": "boolean"
        },
        "selector": {
          "description": "CEL expression.",
          "type": "string"
        },
        "when": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "description": "On a kind with a compiled-in panel: the id of the core section this one follows (docs/PLUGINS.md §4); at the bottom when the panel doesn't show it.",
          "type": "string"
        },
        "badge": {
          "allOf": [
            {
              "$ref": "#/$defs/BadgeItem"
            }
          ],
          "description": "A coloured badge in the section's header, beside the summary (text and severity, as a badges block's items)."
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "type": "array"
        },
        "collapsed": {
          "type": "boolean"
        },
        "icon": {
          "enum": [
            "account_tree",
            "analytics",
            "apps",
            "auto_awesome",
