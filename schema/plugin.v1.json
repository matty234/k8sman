{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "shell"
          ]
        },
        {
          "required": [
            "patch"
          ]
        }
      ],
      "properties": {
        "confirm": {
          "description": "Shell actions are always confirmed in this version.",
          "type": "boolean"
        },
        "dangerous": {
          "description": "Default true. Dangerous actions are styled as such; every plugin action is hidden on read-only contexts.",
          "type": "boolean"
        },
        "icon": {
          "enum": [
            "account_tree",
            "analytics",
            "apps",
            "backup",
            "badge",
