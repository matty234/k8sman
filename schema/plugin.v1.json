        "query": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "Nav": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "type": "string"
        },
        "kinds": {
          "items": {
            "pattern": "^(\\*|[a-z0-9.-]*/[A-Z][A-Za-z0-9]*)$",
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "Panel": {
      "additionalProperties": false,
      "properties": {
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Patch": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "CEL expression.",
          "type": "string"
        },
        "type": {
          "enum": [
            "merge",
            "json"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "body"
      ],
      "type": "object"
    },
    "Permissions": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "description": "Executables shell actions may run on this computer.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "patch": {
          "description": "Kinds patch actions may change (never Secrets).",
          "items": {
            "not": {
              "const": "/Secret"
            },
            "pattern": "^(\\*|[a-z0-9.-]*/[A-Z][A-Za-z0-9]*)$",
            "type": "string"
          },
          "type": "array"
        },
        "prometheus": {
          "description": "PromQL queries through the Prometheus integration (metrics).",
          "type": "boolean"
        },
        "read": {
          "description": "Kinds the plugin reads: its own and related ones. Secrets: names and keys only.",
          "items": {
            "pattern": "^(\\*|[a-z0-9.-]*/[A-Z][A-Za-z0-9]*)$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Related": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "Kind key; must be in permissions.read.",
          "pattern": "^(\\*|[a-z0-9.-]*/[A-Z][A-Za-z0-9]*)$",
          "type": "string"
        },
        "name": {
          "description": "CEL expression.",
          "type": "string"
        },
        "namespace": {
          "description": "CEL expression.",
          "type": "string"
        },
        "owner": {
          "description": "Objects whose ownerReferences include this object (at most 200).",
          "type": "boolean"
        },
        "selector": {
          "description": "CEL expression.",
          "type": "string"
        },
        "when": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
