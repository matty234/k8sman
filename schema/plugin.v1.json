            "timer",
            "tune",
            "upload",
            "verified",
            "vpn_key",
            "warning"
          ],
          "type": "string"
        },
        "placement": {
          "description": "On a kind with a compiled-in panel: the section goes at the top or the bottom (default) of the panel's sections.",
          "enum": [
            "top",
            "bottom"
          ],
          "type": "string"
        },
        "summary": {
          "description": "CEL expression. string: a short text at the right of the section's header (a count, a state).",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "when": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "Severity": {
      "description": "The names a severity expression returns.",
      "enum": [
        "error",
        "warning",
        "ok",
        "info",
        "neutral"
      ]
    },
    "Shell": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "description": "Arguments; $NAME, $NAMESPACE, $CONTEXT, $COL-\u003cNAME\u003e, … are expanded per argument.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "background": {
          "description": "Run without a dock tab and report the exit status and the last lines of output.",
          "type": "boolean"
        },
        "command": {
          "description": "Must be in permissions.commands. Runs without a shell.",
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "items": {
            "$ref": "#/$defs/StatusCount"
          },
          "type": "array"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "StatusCount": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "severity": {
          "description": "Colours the status line when the count isn't zero (default warning).",
          "enum": [
            "critical",
            "error",
            "warning",
            "info"
          ],
          "type": "string"
        },
        "when": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "label",
        "when"
      ],
      "type": "object"
    },
    "Subresource": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "CEL expression. A map sent as JSON (default {}); sees input.",
          "type": "string"
        },
        "group": {
          "description": "The API group serving it (default: the object's), e.g. subresources.kubevirt.io.",
          "type": "string"
        },
        "method": {
          "enum": [
            "PUT",
            "POST"
          ],
          "type": "string"
        },
        "name": {
          "description": "The subresource; kind key + \"/\" + name must be in permissions.subresources.",
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "version": {
          "description": "Its API version (default: the object's).",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Tab": {
      "additionalProperties": false,
      "properties": {
        "icon": {
          "enum": [
            "account_tree",
            "analytics",
            "apps",
            "auto_awesome",
            "backup",
            "badge",
            "block",
            "bolt",
            "build",
