{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "shell"
          ]
        },
        {
          "required": [
            "patch"
          ]
        },
        {
          "required": [
            "subresource"
          ]
        },
        {
          "required": [
            "create"
          ]
        }
      ],
      "properties": {
        "confirm": {
          "description": "Shell actions are always confirmed in this version.",
          "type": "boolean"
        },
        "create": {
          "allOf": [
            {
              "$ref": "#/$defs/Create"
            }
          ],
          "description": "Create an object that refers to this one (e.g. a migration or a snapshot). Since 0.2.20 (set minAppVersion)."
        },
        "dangerous": {
          "description": "Default true. Dangerous actions are styled as such; every plugin action is hidden on read-only contexts.",
          "type": "boolean"
        },
        "icon": {
          "enum": [
            "account_tree",
            "analytics",
            "apps",
            "auto_awesome",
            "backup",
            "badge",
            "block",
            "bolt",
            "build",
            "category",
            "check_circle",
            "checklist",
            "cleaning_services",
            "cloud",
            "code",
            "content_copy",
            "dashboard",
            "data_object",
            "delete",
            "delete_sweep",
            "description",
            "developer_board",
            "dns",
            "edit",
            "edit_note",
            "error",
            "event",
            "extension",
            "fact_check",
            "filter_alt",
            "folder",
            "gpp_maybe",
            "group",
            "history",
            "hub",
            "info",
            "insights",
            "inventory",
            "key",
            "label",
            "lan",
            "language",
            "layers",
            "link",
            "list_alt",
            "lock",
            "memory",
            "monitor_heart",
            "notifications",
            "numbers",
            "open_in_new",
            "person",
            "play_arrow",
            "policy",
            "public",
            "receipt",
            "refresh",
            "restart_alt",
            "rocket_launch",
            "router",
            "rule",
            "schedule",
            "security",
            "settings",
            "shield",
            "speed",
            "stop",
            "storage",
            "sync",
            "sync_alt",
            "task_alt",
            "terminal",
            "timer",
            "tune",
            "upload",
            "verified",
            "vpn_key",
            "warning"
          ],
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        "inputs": {
          "description": "Form fields of a patch, subresource or create action, read as input.\u003cname\u003e.",
          "items": {
            "$ref": "#/$defs/Input"
          },
          "type": "array"
        },
        "label": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/Patch"
        },
        "shell": {
          "$ref": "#/$defs/Shell"
        },
        "shortcut": {
          "type": "string"
        },
        "subresource": {
          "allOf": [
            {
              "$ref": "#/$defs/Subresource"
            }
          ],
          "description": "Call a subresource of the object (e.g. KubeVirt's restart). Since 0.2.20 (set minAppVersion)."
        },
        "when": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "Alert": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "message": {
          "description": "CEL expression.",
          "type": "string"
        },
        "section": {
          "enum": [
            "pods",
            "workloads",
            "jobs",
            "nodes",
            "storage",
            "network",
            "custom"
          ],
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "error",
            "warning",
            "info"
          ],
          "type": "string"
        },
        "since": {
          "description": "CEL expression.",
          "type": "string"
        },
        "when": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "when"
      ],
      "type": "object"
    },
    "BadgeItem": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "description": "CEL expression. string: one of error, warning, ok, info, neutral ($defs/Severity), e.g. '\"error\"' or 'item.ready ? \"ok\" : \"error\"'. Without one the app colours a status value from its text.",
          "examples": [
            "\"error\"",
            "\"warning\"",
            "\"ok\"",
            "\"info\"",
            "\"neutral\""
          ],
          "type": "string"
        },
        "text": {
          "description": "CEL expression.",
          "type": "string"
        },
        "when": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "badges"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/BadgeItem"
                },
                "type": "array"
              }
            },
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "items"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bar"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "label",
                "value",
                "max",
                "format"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "chips"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "string"
              }
            },
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "items",
                "empty"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "code"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "value",
                "language"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "conditions"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "from"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fields"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/FieldItem"
                },
                "type": "array"
              }
            },
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "items"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "json"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "links"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "string"
              }
            },
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "items",
                "empty"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "message"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "text",
                "severity",
                "title"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "settings"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "value",
                "limit",
                "empty"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "type",
                "when",
                "rows",
                "columns",
                "sortBy",
                "descending",
                "limit",
                "empty"
              ]
            }
          }
        }
      ],
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/TableColumn"
          },
          "type": "array"
        },
        "descending": {
          "type": "boolean"
        },
        "empty": {
          "type": "string"
        },
        "format": {
          "enum": [
            "number",
            "quantity",
            "percent"
          ],
          "type": "string"
        },
        "from": {
          "description": "CEL expression.",
          "type": "string"
        },
        "items": {
          "description": "fields and badges: a list of items; chips and links: a CEL expression.",
          "oneOf": [
            {
              "type": "array"
            },
            {
              "description": "CEL expression.",
              "type": "string"
            }
          ]
        },
        "label": {
          "type": "string"
        },
        "language": {
          "enum": [
            "text",
            "yaml",
            "json",
            "shell"
          ],
          "type": "string"
        },
        "limit": {
          "description": "table: rows shown before \"Show all\" (default 20); settings: rows (default 14, at most 50).",
          "type": "integer"
        },
        "max": {
          "description": "CEL expression.",
          "type": "string"
        },
        "rows": {
          "description": "CEL expression.",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "type": "string"
        },
        "sortBy": {
          "type": "string"
        },
        "text": {
          "description": "CEL expression.",
          "type": "string"
        },
        "title": {
          "description": "CEL expression. message: a heading; a warning or error with one is a callout titled with it.",
          "type": "string"
        },
        "type": {
          "enum": [
            "badges",
            "bar",
            "chips",
            "code",
            "conditions",
            "fields",
            "json",
            "links",
            "message",
            "settings",
            "table"
          ],
          "type": "string"
        },
        "value": {
          "description": "CEL expression. bar: a number; code: a string, or any value (shown as YAML, or JSON with language json); json: any value; settings: a map, flattened into path → value rows (references become links).",
          "type": "string"
        },
        "when": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "age",
            "until",
            "status",
            "percent",
            "bool",
            "labels",
            "quantity",
            "bytes"
          ],
          "type": "string"
        },
        "value": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "Create": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "CEL expression. The object: a map with apiVersion, kind (matching create.kind) and metadata.name or metadata.generateName; its namespace is the object's. Sees input.",
          "type": "string"
        },
        "kind": {
          "description": "Kind key of the object created; must be in permissions.create.",
          "pattern": "^[a-z0-9.-]*/[A-Z][A-Za-z0-9]*$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "body"
      ],
      "type": "object"
    },
    "FieldItem": {
      "additionalProperties": false,
      "properties": {
        "copy": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "link": {
          "description": "CEL expression.",
          "type": "string"
        },
        "mono": {
          "description": "Draw the value in the monospace font.",
          "type": "boolean"
        },
        "severity": {
          "description": "CEL expression. string: one of error, warning, ok, info, neutral ($defs/Severity), e.g. '\"error\"' or 'item.ready ? \"ok\" : \"error\"'. Without one the app colours a status value from its text.",
          "examples": [
            "\"error\"",
            "\"warning\"",
            "\"ok\"",
            "\"info\"",
            "\"neutral\""
          ],
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "number",
            "bool",
            "status",
            "age",
            "until",
            "timestamp",
            "quantity",
            "labels",
            "url",
            "code"
          ],
          "type": "string"
        },
        "value": {
          "description": "CEL expression.",
          "type": "string"
        },
        "when": {
          "description": "CEL expression.",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "type": "object"
    },
    "Input": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "description": "CEL expression.",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "options": {
          "description": "The choices of an enum input.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "string",
            "int",
            "bool",
            "enum"
          ],
          "type": "string"
        },
        "validate": {
          "description": "CEL expression.",
          "type": "string"
        },
        "validateMessage": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Kind": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "type": "array"
        },
        "alerts": {
          "items": {
            "$ref": "#/$defs/Alert"
          },
          "type": "array"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "type": "array"
        },
        "exceptKinds": {
          "description": "Only for \"*\": kind keys (group/Kind) the entry doesn't apply to; the app doesn't fetch the plugin's panel for them.",
          "items": {
            "pattern": "^[a-z0-9.-]*/[A-Z][A-Za-z0-9]*$",
            "type": "string"
          },
          "type": "array"
        },
        "hideColumns": {
          "description": "Default columns to drop, by name (any case); \"*\" drops every default but Name, Namespace and Age.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "icon": {
          "enum": [
            "account_tree",
            "analytics",
            "apps",
            "auto_awesome",
            "backup",
            "badge",
            "block",
            "bolt",
            "build",
