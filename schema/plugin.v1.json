  "$id": "https://raw.githubusercontent.com/matty234/k8sman/main/schema/plugin.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A k8sman runtime plugin. See docs/PLUGINS.md. CEL fields are strings; `k8sman-server plugin validate` checks them.",
  "properties": {
    "apiVersion": {
      "const": "k8sman.dev/v1",
      "type": "string"
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "description": {
      "maxLength": 200,
      "type": "string"
    },
    "homepage": {
      "format": "uri",
      "type": "string"
    },
    "id": {
      "description": "Lower-case letters, digits and dashes; unique in the index.",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$",
      "type": "string"
    },
    "kinds": {
      "additionalProperties": {
        "$ref": "#/$defs/Kind"
      },
      "description": "Kind key (group/Kind, e.g. cert-manager.io/Certificate or /Pod; \"*\" for any kind: variables, related, metrics, panel sections and tabs, actions) → what the plugin adds to it.",
      "propertyNames": {
        "pattern": "^(\\*|[a-z0-9.-]*/[A-Z][A-Za-z0-9]*)$"
      },
      "type": "object"
    },
    "minAppVersion": {
      "description": "The oldest k8sman that can load this plugin; older apps say so instead of failing.",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "nav": {
      "$ref": "#/$defs/Nav"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    },
    "version": {
      "description": "Semantic version, e.g. 1.0.0.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "id",
    "name",
    "version",
    "kinds"
  ],
  "title": "k8sman plugin (plugin.yaml, k8sman.dev/v1)",
  "type": "object"
}
