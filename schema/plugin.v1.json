          ],
          "type": "string"
        },
        "id": {
          "description": "Identifies the tab (the app remembers the open tab by it, so the title can change): unique among the entry's tabs. Default: a slug of the title.",
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "into": {
          "description": "A tab of the app's own that these sections join on kinds that have it (security: the Security tab of Pods and workloads); elsewhere the tab is a tab of its own. More host tabs may be added in later versions.",
          "enum": [
            "security"
          ],
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "when": {
          "description": "CEL expression. bool: whether the tab shows for this object (may read related).",
          "type": "string"
        }
      },
      "required": [
        "title",
        "sections"
      ],
      "type": "object"
    },
    "TableColumn": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "description": "Draw the column on a line of its own under the row, across the table (a message, a description).",
          "type": "boolean"
        },
        "link": {
          "description": "CEL expression.",
          "type": "string"
        },
        "mono": {
          "description": "Draw the cells in the monospace font.",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "severity": {
          "description": "CEL expression. string: one of error, warning, ok, info, neutral ($defs/Severity), e.g. '\"error\"' or 'item.ready ? \"ok\" : \"error\"'. Without one the app colours a status value from its text.",
          "examples": [
            "\"error\"",
            "\"warning\"",
            "\"ok\"",
            "\"info\"",
            "\"neutral\""
          ],
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
