          "name": "K8smanTestAlert",
          "query": "vector(1)",
          "duration": 60,
          "labels": {
            "namespace": "demo",
            "severity": "warning"
          },
          "annotations": {
            "description": "Always fires one minute after the rule loads. Use it to try silences in k8sman.",
            "runbook_url": "https://github.com/bargrove/k8sman/blob/master/docs/PROMETHEUS.md",
            "summary": "Test alert from the k8sman demo rules"
          },
          "state": "firing",
          "health": "ok",
          "lastEvaluation": "2026-11-03T13:08:45.415391798Z",
          "evaluationTime": 0.001539125,
          "alerts": [
            {
              "labels": {
                "alertname": "K8smanTestAlert",
                "namespace": "demo",
                "severity": "warning"
              },
              "annotations": {
                "description": "Always fires one minute after the rule loads. Use it to try silences in k8sman.",
                "runbook_url": "https://github.com/bargrove/k8sman/blob/master/docs/PROMETHEUS.md",
                "summary": "Test alert from the k8sman demo rules"
              },
              "state": "firing",
              "activeAt": "2026-11-03T12:48:45.404916777Z",
              "value": "1e+00"
            }
          ]
        },
        {
          "type": "alerting",
          "name": "K8smanDemoPodCrashLooping",
          "query": "max_over_time(kube_pod_container_status_waiting_reason{namespace=\"demo\",reason=\"CrashLoopBackOff\"}[5m]) >= 1",
          "duration": 120,
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "description": "Container {{ $labels.container }} of pod {{ $labels.namespace }}/{{ $labels.pod }} has been in CrashLoopBackOff for more than 2 minutes.",
            "runbook_url": "https://runbooks.prometheus-operator.dev/runbooks/kubernetes/kubepodcrashlooping",
            "summary": "Pod {{ $labels.namespace }}/{{ $labels.pod }} is crash looping"
          },
          "state": "firing",
          "health": "ok",
          "lastEvaluation": "2026-11-03T13:08:45.416956132Z",
          "evaluationTime": 0.001119959,
          "alerts": [
            {
              "labels": {
                "alertname": "K8smanDemoPodCrashLooping",
                "container": "app",
                "endpoint": "http",
                "instance": "10.244.0.120:8080",
                "job": "kube-state-metrics",
                "namespace": "demo",
                "pod": "crashy",
                "reason": "CrashLoopBackOff",
                "service": "kube-prometheus-stack-kube-state-metrics",
                "severity": "critical",
                "uid": "327d9fb7-7696-4c09-a53a-779f7986e5fc"
              },
              "annotations": {
                "description": "Container app of pod demo/crashy has been in CrashLoopBackOff for more than 2 minutes.",
